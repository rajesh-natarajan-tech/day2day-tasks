; Reverse zone for 192.168.56.0/24
$TTL 3600
@       IN  SOA ns1.home.lab.com. admin.home.lab.com. (
            2026101701  ; serial (YYYYMMDDnn) - bump on every change
            3600        ; refresh
            900         ; retry
            604800      ; expire
            300 )       ; negative cache TTL

@       IN  NS      ns1.home.lab.com.

10      IN  PTR     ns1.home.lab.com.
11      IN  PTR     master.home.lab.com.
101     IN  PTR     vm1.home.lab.com.
102     IN  PTR     vm2.home.lab.com.
103     IN  PTR     vm3.home.lab.com.
