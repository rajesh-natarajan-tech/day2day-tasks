; Reverse zone for 192.168.56.0/24
; Increase the serial (YYYYMMDDNN) every time you edit this file
$TTL 3600
@       IN  SOA ns1.home.lab.com. admin.home.lab.com. (
                2026101701  ; serial
                3600        ; refresh
                900         ; retry
                604800      ; expire
                300 )       ; negative cache TTL

@       IN  NS      ns1.home.lab.com.

2       IN  PTR     ns1.home.lab.com.
10      IN  PTR     k8s-master.home.lab.com.
11      IN  PTR     k8s-worker1.home.lab.com.
12      IN  PTR     k8s-worker2.home.lab.com.
